#usda 1.0
(
    defaultPrim = "Zone_RoofSupport"
)

def Xform "Zone_RoofSupport" (
    customData = {
        string harness_hazard_type = "unsupported_beam_collapse"
        string harness_activation = "move SupportPrimary away in an experiment override or through physical contact"
        string harness_physical_mechanism = "dynamic BeamPrimary is supported only by SupportPrimary; no timer or scripted body-state toggle"
        string harness_status = "physically_operational"
    }
)
{
    def Xform "BeamPrimary" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        customData = {
            string harness_role = "roof_beam"
            string harness_interactive = "true"
            string harness_failure_role = "falls under gravity after support removal"
        }
    )
    {
        double3 xformOp:translate = (3.5, 0, 3.26)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = false
        float physics:mass = 72
        def Cube "CollisionAndVisual" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3 xformOp:scale = (2.4, 0.35, 0.25)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            bool physics:collisionEnabled = true
            rel material:binding = </World/Looks/Steel>
        }
        def Cube "HazardStripe"
        {
            double3 xformOp:translate = (0, -0.72, 0)
            float3 xformOp:scale = (0.50, 0.015, 0.27)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </World/Looks/SafetyYellow>
        }
    }

    def Xform "SupportPrimary" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        customData = {
            string harness_role = "movable_roof_support"
            string harness_interactive = "true"
            string harness_experiment_operation = "author a stronger override with a translated xform; use kinematic mode for deterministic displacement"
        }
    )
    {
        double3 xformOp:translate = (3.5, 0, 1.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = false
        float physics:mass = 45
        def Cube "CollisionAndVisual" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            float3 xformOp:scale = (0.35, 0.35, 1.5)
            uniform token[] xformOpOrder = ["xformOp:scale"]
            bool physics:collisionEnabled = true
            rel material:binding = </World/Looks/SafetyYellow>
        }
        def Cube "BasePlate"
        {
            double3 xformOp:translate = (0, 0, -1.53)
            float3 xformOp:scale = (0.60, 0.60, 0.03)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </World/Looks/Steel>
        }
    }

    def Xform "InteractionTarget" (
        customData = {
            string harness_role = "support_manipulation_target"
            string harness_interactive = "true"
        }
    )
    {
        double3 xformOp:translate = (3.5, -0.85, 1.1)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        def Cylinder "Marker"
        {
            float radius = 0.18
            float height = 0.08
            double3 xformOp:translate = (0, 0, 0.04)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/Looks/LampGlow>
        }
    }
}
