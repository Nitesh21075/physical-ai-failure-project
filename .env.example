# Copy this file to .env and fill in only the credentials needed locally.
# Never commit .env or real credentials.
# scripts/run_dashboard.py loads this file automatically without overriding
# variables explicitly set in the shell.

# Optional world-model/provider credentials
ALAKAZAM_API_KEY=
REACTOR_API_KEY=
# Maximum simultaneous browser sessions minted by the live Reactor tab (default: 1).
REACTOR_MAX_LIVE_SESSIONS=1

# Optional model/API credentials
OPENAI_API_KEY=
RESEARCH_MODEL_PROVIDER=openai
RESEARCH_MODEL=
# Optional override for the image-based visual assessor. It defaults to RESEARCH_MODEL.
VISUAL_ASSESSMENT_MODEL=
# The Isaac worker must bind only to a localhost address on the AWS host.
ISAAC_WORKER_URL=http://127.0.0.1:8211
# Verified Isaac 6.0.1 transport: NVIDIA's in-Kit Python Server. Keep both
# values loopback-local and provide a unique token when launching the container.
ISAAC_TRANSPORT=nvidia-python-server
ISAAC_PYTHON_SERVER_ADDRESS=127.0.0.1:8226
ISAAC_PYTHON_SERVER_TOKEN=
ANTHROPIC_API_KEY=

# Optional AWS/Isaac workstation configuration
AWS_REGION=
ISAAC_SIM_ROOT=
ISAAC_SIM_CONTAINER=
